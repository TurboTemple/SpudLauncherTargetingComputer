{
  "name": "spud-app",
  "version": "0.1.0",
  "private": true,
  "description": "Phone web app that predicts where a potato cannon shot will land.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "geomagnetism": "^0.2.0",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
